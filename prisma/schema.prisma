generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  nickname     String
  nicknameKey  String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  chats        Chat[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Chat {
  id                   String    @id @default(uuid())
  userId               String
  title                String    @default("New chat")
  nansenConversationId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages             Message[]

  @@index([userId, updatedAt])
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    String
  role      String
  content   String
  status    String   @default("complete")
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@index([chatId, id])
}

/// Saved Nansen readings. Visitors read these rows. A background refresh rewrites them.
model NansenSnapshot {
  key          String   @id
  payload      String
  fetchedAt    DateTime
  stale        Boolean  @default(false)
  refreshError String?
  updatedAt    DateTime @updatedAt
}

/// Canonical Reality stock instruments synchronized from Bitget's public catalog.
model BitgetAsset {
  providerInstrumentId String   @id
  symbol               String   @unique
  underlyingTicker     String
  companyName          String?
  tradingPeriodJson    String
  weekendTradable      String?
  sourceRequestTime     String?
  listingStatus        String   @default("active")
  firstSeenAt          DateTime @default(now())
  lastVerifiedAt       DateTime
  observations         BitgetSignalObservation[]

  @@index([underlyingTicker])
  @@index([companyName])
  @@index([listingStatus, lastVerifiedAt])
  signalCoverage       BitgetSignalCoverage[]
  theses               Thesis[]
}

/// Cached normalized observations; a cache key includes normalized request parameters.
model BitgetSignalObservation {
  cacheKey      String     @id
  instrumentId  String
  signalType    String
  payload       String
  fetchedAt     DateTime
  instrument    BitgetAsset @relation(fields: [instrumentId], references: [providerInstrumentId], onDelete: Cascade)

  @@index([instrumentId, signalType, fetchedAt])
}

/// Latest observed signal coverage per instrument and signal type.

model BitgetSignalCoverage {
  instrumentId    String
  signalType      String
  status          String
  lastAttemptedAt DateTime
  lastSucceededAt DateTime?
  source          String
  errorCode       String?
  errorMessage    String?
  updatedAt       DateTime @updatedAt

  instrument BitgetAsset @relation(fields: [instrumentId], references: [providerInstrumentId], onDelete: Cascade)

  @@id([instrumentId, signalType])
  @@index([signalType, status])
  @@index([lastAttemptedAt])
}

model Thesis {
  id           String   @id @default(cuid())
  title        String
  content      String?
  instrumentId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instrument   BitgetAsset? @relation(fields: [instrumentId], references: [providerInstrumentId], onDelete: SetNull)
}
